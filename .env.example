# Copy to .env.local at the project root. Never commit actual credentials.
# Explicit demo mode; no credentials required. Not secure account storage.
NEXT_PUBLIC_DATA_MODE=mock

# For real persistence select supabase and fill in project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Seed script only. Never NEXT_PUBLIC_ or used for ordinary app requests.
SUPABASE_SECRET_KEY=
