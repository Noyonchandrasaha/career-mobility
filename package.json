{
  "name": "career-mobility-platform",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:validate": "vitest run tests/dataset.test.ts",
    "seed": "tsx scripts/seed.ts",
    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "test:rls": "vitest run tests/rls.test.ts",
    "test:e2e": "playwright test",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=docs/evidence/vitest-results.json",
    "evidence": "tsx scripts/generate-evidence.ts",
    "package:submission": "node scripts/package-submission.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
